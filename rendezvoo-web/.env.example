# Copy this file to .env.local and fill it in. Never commit .env.local.
# Supabase → Project Settings → API

# Safe for the browser (NEXT_PUBLIC_ means it's sent to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only (used by /api/plan and the seed script — never sent to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SERPAPI_KEY=your-serpapi-key
GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-3.8-flash

# Only for `npm run seed` (fake home locations are placed around this point)
SEED_LAT=00.0000
SEED_LNG=-00.0000
SEED_AREA=Downtown, Your City
